            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Bail out if a stage failed (setup/auth)" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get(&apos;failedStage&apos;) as boolean)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="14 E2E journey" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>

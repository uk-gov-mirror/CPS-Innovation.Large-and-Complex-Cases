          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="LCC auth + CMS cookie" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${aadToken}</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Correlation-Id</stringProp>
                  <stringProp name="Header.value">${correlationId}</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Cms-Auth-Values=${cmsAuth}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Check case is found" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>

            <intProp name="ActionProcessor.target">0</intProp>
            <stringProp name="ActionProcessor.duration">0</stringProp>
          </TestAction>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If not transfer mode: upload and wait for Egress" enabled="true">
          <stringProp name="TestPlan.comments">Transfer mode skips this: the file was uploaded by an earlier upload-mode run.</stringProp>
          <stringProp name="IfController.condition">${__groovy(vars.get(&apos;mode&apos;) != &apos;transfer&apos;)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Egress upload (chunked)" enabled="true"/>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03 Egress upload - initiate" enabled="true">
              <stringProp name="HTTPSampler.path">${egressBaseUrl}/api/v1/workspaces/${workspaceId}/uploads</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;filename&quot;: &quot;${fileName}&quot;, &quot;filesize&quot;: ${fileSizeBytes}, &quot;folder_path&quot;: &quot;${egressSourceFolder}&quot;}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Egress JSON headers" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Basic ${egressToken}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep upload id" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename">${groovyDir}/upload-initiate-post.groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script"></stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="While more chunks" enabled="true">
              <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;moreChunks&apos;) == &apos;true&apos;)}</stringProp>
            </WhileController>
            <hashTree>
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare next chunk" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename">${groovyDir}/chunk-prepare.groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script"></stringProp>
              </JSR223Sampler>
              <hashTree/>
              <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="While chunk not accepted (retry loop)" enabled="true">
                <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;retryChunk&apos;) == &apos;true&apos;)}</stringProp>
              </WhileController>
              <hashTree>
                <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If this is a retry" enabled="true">
                  <stringProp name="IfController.condition">${__groovy((vars.get(&apos;chunkAttempt&apos;) as int) &gt; 0)}</stringProp>
                  <boolProp name="IfController.evaluateAll">false</boolProp>
                  <boolProp name="IfController.useExpression">true</boolProp>
                </IfController>
                <hashTree>
                  <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Back off before chunk retry" enabled="true">
                    <intProp name="ActionProcessor.action">1</intProp>
                    <intProp name="ActionProcessor.target">0</intProp>
                    <stringProp name="ActionProcessor.duration">${chunkRetryDelayMs}</stringProp>
                  </TestAction>
                  <hashTree/>
                </hashTree>
                <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Egress token missing, old or rejected" enabled="true">
                  <stringProp name="IfController.condition">${__groovy(vars.get(&apos;egressReauth&apos;) == &apos;true&apos; || System.currentTimeMillis() - (vars.get(&apos;egressTokenAt&apos;) as long) &gt; (vars.get(&apos;egressRefreshMin&apos;) as long) * 60000L)}</stringProp>
                  <boolProp name="IfController.evaluateAll">false</boolProp>
                  <boolProp name="IfController.useExpression">true</boolProp>
                </IfController>
                <hashTree>
                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="02 Egress auth" enabled="true">
                    <stringProp name="HTTPSampler.path">${egressBaseUrl}/api/v1/user/auth/</stringProp>
                    <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                    <stringProp name="HTTPSampler.method">GET</stringProp>
                    <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                    <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                    <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                      <collectionProp name="Arguments.arguments"/>

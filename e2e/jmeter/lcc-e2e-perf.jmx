<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="LCC E2E perf - Egress upload + Egress to NetApp transfer">
      <stringProp name="TestPlan.comments">Run via scripts/Run-PerfTest.ps1, or: jmeter -n -t lcc-e2e-perf.jmx -q config/load-profile.properties -q config/env-staging.properties. Every value below is a JMeter property (override with -Jname=value). Step logic lives in groovy/*.groovy. See README.md.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="users" elementType="Argument">
            <stringProp name="Argument.name">users</stringProp>
            <stringProp name="Argument.value">${__P(users,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="rampUpSec" elementType="Argument">
            <stringProp name="Argument.name">rampUpSec</stringProp>
            <stringProp name="Argument.value">${__P(rampUpSec,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="loops" elementType="Argument">
            <stringProp name="Argument.name">loops</stringProp>
            <stringProp name="Argument.value">${__P(loops,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="lccApiBaseUrl" elementType="Argument">
            <stringProp name="Argument.name">lccApiBaseUrl</stringProp>
            <stringProp name="Argument.value">${__P(lccApiBaseUrl,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressBaseUrl" elementType="Argument">
            <stringProp name="Argument.name">egressBaseUrl</stringProp>
            <stringProp name="Argument.value">${__P(egressBaseUrl,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="aadAuthority" elementType="Argument">
            <stringProp name="Argument.name">aadAuthority</stringProp>
            <stringProp name="Argument.value">${__P(aadAuthority,https://login.microsoftonline.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="tenantId" elementType="Argument">
            <stringProp name="Argument.name">tenantId</stringProp>
            <stringProp name="Argument.value">${__P(tenantId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="lccApiClientId" elementType="Argument">
            <stringProp name="Argument.name">lccApiClientId</stringProp>
            <stringProp name="Argument.value">${__P(lccApiClientId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="aadUsername" elementType="Argument">
            <stringProp name="Argument.name">aadUsername</stringProp>
            <stringProp name="Argument.value">${__P(aadUsername,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="aadPassword" elementType="Argument">
            <stringProp name="Argument.name">aadPassword</stringProp>
            <stringProp name="Argument.value">${__P(aadPassword,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressServiceAccountAuth" elementType="Argument">
            <stringProp name="Argument.name">egressServiceAccountAuth</stringProp>
            <stringProp name="Argument.value">${__P(egressServiceAccountAuth,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressSourceFolder" elementType="Argument">
            <stringProp name="Argument.name">egressSourceFolder</stringProp>
            <stringProp name="Argument.value">${__P(egressSourceFolder,1. ABEs for Transcript/)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="transferType" elementType="Argument">
            <stringProp name="Argument.name">transferType</stringProp>
            <stringProp name="Argument.value">${__P(transferType,Copy)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="casesCsv" elementType="Argument">
            <stringProp name="Argument.name">casesCsv</stringProp>
            <stringProp name="Argument.value">${__P(casesCsv,data/cases-staging.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="allowSharedCase" elementType="Argument">
            <stringProp name="Argument.name">allowSharedCase</stringProp>
            <stringProp name="Argument.value">${__P(allowSharedCase,false)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="filePrefix" elementType="Argument">
            <stringProp name="Argument.name">filePrefix</stringProp>
            <stringProp name="Argument.value">${__P(filePrefix,jmeter-perf)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="uploadExtension" elementType="Argument">
            <stringProp name="Argument.name">uploadExtension</stringProp>
            <stringProp name="Argument.value">${__P(uploadExtension,txt)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="chunkSizeMb" elementType="Argument">
            <stringProp name="Argument.name">chunkSizeMb</stringProp>
            <stringProp name="Argument.value">${__P(chunkSizeMb,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="maxChunkRetries" elementType="Argument">
            <stringProp name="Argument.name">maxChunkRetries</stringProp>
            <stringProp name="Argument.value">${__P(maxChunkRetries,3)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="chunkRetryDelayMs" elementType="Argument">
            <stringProp name="Argument.name">chunkRetryDelayMs</stringProp>
            <stringProp name="Argument.value">${__P(chunkRetryDelayMs,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressPollIntervalMs" elementType="Argument">
            <stringProp name="Argument.name">egressPollIntervalMs</stringProp>
            <stringProp name="Argument.value">${__P(egressPollIntervalMs,2000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressProcessingTimeoutSec" elementType="Argument">
            <stringProp name="Argument.name">egressProcessingTimeoutSec</stringProp>
            <stringProp name="Argument.value">${__P(egressProcessingTimeoutSec,90)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="validateBeforeTransfer" elementType="Argument">
            <stringProp name="Argument.name">validateBeforeTransfer</stringProp>
            <stringProp name="Argument.value">${__P(validateBeforeTransfer,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="transferPollIntervalSec" elementType="Argument">
            <stringProp name="Argument.name">transferPollIntervalSec</stringProp>
            <stringProp name="Argument.value">${__P(transferPollIntervalSec,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="transferTimeoutMin" elementType="Argument">
            <stringProp name="Argument.name">transferTimeoutMin</stringProp>
            <stringProp name="Argument.value">${__P(transferTimeoutMin,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="clearTransfers" elementType="Argument">
            <stringProp name="Argument.name">clearTransfers</stringProp>
            <stringProp name="Argument.value">${__P(clearTransfers,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="aadRefreshMin" elementType="Argument">
            <stringProp name="Argument.name">aadRefreshMin</stringProp>
            <stringProp name="Argument.value">${__P(aadRefreshMin,45)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressRefreshMin" elementType="Argument">
            <stringProp name="Argument.name">egressRefreshMin</stringProp>
            <stringProp name="Argument.value">${__P(egressRefreshMin,8)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="httpConnectTimeoutMs" elementType="Argument">
            <stringProp name="Argument.name">httpConnectTimeoutMs</stringProp>
            <stringProp name="Argument.value">${__P(httpConnectTimeoutMs,30000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="httpResponseTimeoutMs" elementType="Argument">
            <stringProp name="Argument.name">httpResponseTimeoutMs</stringProp>
            <stringProp name="Argument.value">${__P(httpResponseTimeoutMs,300000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="resultsDir" elementType="Argument">
            <stringProp name="Argument.name">resultsDir</stringProp>
            <stringProp name="Argument.value">${__P(resultsDir,results/adhoc)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cmrcApiClientId" elementType="Argument">
            <stringProp name="Argument.name">cmrcApiClientId</stringProp>
            <stringProp name="Argument.value">${__P(cmrcApiClientId,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ddeiBaseUrl" elementType="Argument">
            <stringProp name="Argument.name">ddeiBaseUrl</stringProp>
            <stringProp name="Argument.value">${__P(ddeiBaseUrl,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ddeiAccessKey" elementType="Argument">
            <stringProp name="Argument.name">ddeiAccessKey</stringProp>
            <stringProp name="Argument.value">${__P(ddeiAccessKey,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cmsUsername" elementType="Argument">
            <stringProp name="Argument.name">cmsUsername</stringProp>
            <stringProp name="Argument.value">${__P(cmsUsername,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cmsPassword" elementType="Argument">
            <stringProp name="Argument.name">cmsPassword</stringProp>
            <stringProp name="Argument.value">${__P(cmsPassword,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="searchCase" elementType="Argument">
            <stringProp name="Argument.name">searchCase</stringProp>
            <stringProp name="Argument.value">${__P(searchCase,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cmsRefreshMin" elementType="Argument">
            <stringProp name="Argument.name">cmsRefreshMin</stringProp>
            <stringProp name="Argument.value">${__P(cmsRefreshMin,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressFixedWaitSec" elementType="Argument">
            <stringProp name="Argument.name">egressFixedWaitSec</stringProp>
            <stringProp name="Argument.value">${__P(egressFixedWaitSec,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="waitForEgressListing" elementType="Argument">
            <stringProp name="Argument.name">waitForEgressListing</stringProp>
            <stringProp name="Argument.value">${__P(waitForEgressListing,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressListingTimeoutSec" elementType="Argument">
            <stringProp name="Argument.name">egressListingTimeoutSec</stringProp>
            <stringProp name="Argument.value">${__P(egressListingTimeoutSec,90)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressListingPollIntervalMs" elementType="Argument">
            <stringProp name="Argument.name">egressListingPollIntervalMs</stringProp>
            <stringProp name="Argument.value">${__P(egressListingPollIntervalMs,3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="egressListingTake" elementType="Argument">
            <stringProp name="Argument.name">egressListingTake</stringProp>
            <stringProp name="Argument.value">${__P(egressListingTake,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="transferMaxPolls" elementType="Argument">
            <stringProp name="Argument.name">transferMaxPolls</stringProp>
            <stringProp name="Argument.value">${__P(transferMaxPolls,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cleanupEgressAfterCopy" elementType="Argument">
            <stringProp name="Argument.name">cleanupEgressAfterCopy</stringProp>
            <stringProp name="Argument.value">${__P(cleanupEgressAfterCopy,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="fileSizesMb" elementType="Argument">
            <stringProp name="Argument.name">fileSizesMb</stringProp>
            <stringProp name="Argument.value">${__P(fileSizesMb,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="mode" elementType="Argument">
            <stringProp name="Argument.name">mode</stringProp>
            <stringProp name="Argument.value">${__P(mode,e2e)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="preparedCsv" elementType="Argument">
            <stringProp name="Argument.name">preparedCsv</stringProp>
            <stringProp name="Argument.value">${__P(preparedCsv,data/egress-files-staging.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="caseOffset" elementType="Argument">
            <stringProp name="Argument.name">caseOffset</stringProp>
            <stringProp name="Argument.value">${__P(caseOffset,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="cleanupNetAppAfterTransfer" elementType="Argument">
            <stringProp name="Argument.name">cleanupNetAppAfterTransfer</stringProp>
            <stringProp name="Argument.value">${__P(cleanupNetAppAfterTransfer,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="runId" elementType="Argument">
            <stringProp name="Argument.name">runId</stringProp>
            <stringProp name="Argument.value">${__P(runId,${__time(yyyyMMdd-HHmmss,)})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="groovyDir" elementType="Argument">
            <stringProp name="Argument.name">groovyDir</stringProp>
            <stringProp name="Argument.value">${__groovy(org.apache.jmeter.services.FileServer.fileServer.baseDir + &apos;/groovy&apos;,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="HTTPSampler.connect_timeout">${httpConnectTimeoutMs}</stringProp>
        <stringProp name="HTTPSampler.response_timeout">${httpResponseTimeoutMs}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp - validate config" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="00 Setup - validate config" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename">${groovyDir}/setup-validate.groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="E2E users" enabled="true">
        <stringProp name="TestPlan.comments">One thread = one user = one case row from the cases CSV. Each iteration uploads one file to Egress and moves it to NetApp.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUpSec,30)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(loops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="00 Init iteration" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename">${groovyDir}/iteration-init.groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If AAD token missing or old">
          <stringProp name="IfController.condition">${__groovy(System.currentTimeMillis() - (vars.get(&apos;aadTokenAt&apos;) as long) &gt; (vars.get(&apos;aadRefreshMin&apos;) as long) * 60000L)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01 AAD token" enabled="true">
            <stringProp name="HTTPSampler.path">${aadAuthority}/${tenantId}/oauth2/v2.0/token</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
                <elementProp name="client_id" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">client_id</stringProp>
                  <stringProp name="Argument.value">${lccApiClientId}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
                <elementProp name="scope" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">scope</stringProp>
                  <stringProp name="Argument.value">api://${lccApiClientId}/user_impersonation</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
                <elementProp name="username" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">username</stringProp>
                  <stringProp name="Argument.value">${aadUsername}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
                <elementProp name="password" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">password</stringProp>
                  <stringProp name="Argument.value">${aadPassword}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
                <elementProp name="grant_type" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">grant_type</stringProp>
                  <stringProp name="Argument.value">password</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep AAD token" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename">${groovyDir}/aad-token-post.groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Egress token missing, old or rejected" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get(&apos;egressReauth&apos;) == &apos;true&apos; || System.currentTimeMillis() - (vars.get(&apos;egressTokenAt&apos;) as long) &gt; (vars.get(&apos;egressRefreshMin&apos;) as long) * 60000L)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="02 Egress auth" enabled="true">
            <stringProp name="HTTPSampler.path">${egressBaseUrl}/api/v1/user/auth/</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Service account auth" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Basic ${egressServiceAccountAuth}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep Egress token" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename">${groovyDir}/egress-auth-post.groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If searchCase or NetApp clean-up, and CMS session missing or old" enabled="true">
          <stringProp name="IfController.condition">${__groovy((vars.get(&apos;searchCase&apos;) == &apos;true&apos; || vars.get(&apos;cleanupNetAppAfterTransfer&apos;) == &apos;true&apos;) &amp;&amp; System.currentTimeMillis() - (vars.get(&apos;cmsAuthAt&apos;) as long) &gt; (vars.get(&apos;cmsRefreshMin&apos;) as long) * 60000L)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01a CMRC token (for DDEI)" enabled="true">
            <stringProp name="HTTPSampler.path">${aadAuthority}/${tenantId}/oauth2/v2.0/token</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>

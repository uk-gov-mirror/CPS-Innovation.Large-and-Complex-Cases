              <stringProp name="script"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01b CMS auth (DDEI)" enabled="true">
            <stringProp name="HTTPSampler.path">${ddeiBaseUrl}/authenticate</stringProp>
